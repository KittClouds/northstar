    "partition_authority_not_inferred": true,
    "preservation_requires_positive_authority": true,
    "bounded_silence_is_not_preservation": true
  },
  "lawful_overlap_rule": {
    "definition": "Q_ij = Q_i intersect Q_j under both correspondence and context contracts.",
    "outcome_conditioned_subset_selection_forbidden": true,
    "pair_identity_must_be_common": true,
    "orientation": "preserve if either relation is directional; otherwise canonical unordered pair"
  },
  "relation_signature_rule": {
