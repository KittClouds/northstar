{
  "schema": "DARK_FOREST_TRIANGULATION_CONSTITUTION_V1",
  "phase": "HORIZONTAL_TRIANGULATION",
  "purpose": "Map typed relational geometry of independently qualified observer optics without binding Thing 2.",
  "primary_boundary": "Each optic must first produce and seal its native scientific object; cross-optic comparison is downstream only.",
  "relation_status_vocabulary": [
    "DISTINGUISHED",
    "PRESERVED_EXACT",
    "BOUNDED_SILENCE",
    "NOT_COMPARABLE",
    "NOT_EVALUABLE"
  ],
  "native_object_rule": {
